# EduOps360 Environment Variables
# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Google Workspace account that sends login codes (use an App Password)
SMTP_USER=
SMTP_PASS=
# Optional (defaults: smtp.gmail.com / 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Turso database (leave empty locally to use server/database.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
